# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=karabakh

# Server
PORT=4000
NODE_ENV=production

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# Optional: S3 for file uploads (if using S3 instead of local storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=karabakh-uploads

# AI assistant (chatbot). Works without any key via a free provider, but the
# free tier is limited to ~1 reply / 30s per IP. For unlimited, fast answers
# set ONE of the keys below (the app picks whichever is present, in this order):
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# Optional local model via Ollama:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2